{
  "description": "advanced-memory (Claude Code + Codex): detect new directories, scaffold folder memory (CLAUDE.md / AGENTS.md), remind the agent to fill/refresh it before finishing",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dir-sync.mjs\" --mode=session",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dir-sync.mjs\" --mode=diff",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/dir-sync.mjs\" --mode=stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
